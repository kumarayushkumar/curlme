meta {
  name: get feed
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/feed?page=1&limit=5
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 5
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("returns a paginated feed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.feed.posts).to.be.an("array");
    expect(res.getBody().data.feed.pagination.currentPage).to.equal(1);
  });
}

docs {
  `GET /api/feed` - the global feed, served from the Redis cache and falling
  back to Postgres. `limit` defaults to 5.
}
