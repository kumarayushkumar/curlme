meta {
  name: create post
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/create-post
  body: json
  auth: inherit
}

body:json {
  {
    "content": "hello from bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("postId", res.getBody().data.post.postId);
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test("returns the created post and saves its id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.post.postId).to.be.a("string");
    expect(bru.getEnvVar("postId")).to.equal(res.getBody().data.post.postId);
  });
}

docs {
  `POST /api/create-post` - `content` is required, trimmed, 1 to 500
  characters. The new `postId` is written into the environment.
}
