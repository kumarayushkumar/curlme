meta {
  name: list user following
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/following/:username?page=1&limit=20
  body: none
  auth: inherit
}

params:path {
  username: {{targetUsername}}
}

params:query {
  page: 1
  limit: 20
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  `GET /api/following/:username` - the accounts someone else follows.
}
