meta {
  name: toggle like reply
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/toggle-like-reply/:replyId
  body: none
  auth: inherit
}

params:path {
  replyId: {{replyId}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  `POST /api/toggle-like-reply/:replyId` - likes the reply, or removes the
  like if it is already there.
}
