meta {
  name: create reply
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/create-reply/:postId
  body: json
  auth: inherit
}

params:path {
  postId: {{postId}}
}

body:json {
  {
    "content": "replying from bruno"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("replyId", res.getBody().data.reply.replyId);
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test("returns the created reply and saves its id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.reply.replyId).to.be.a("string");
    expect(bru.getEnvVar("replyId")).to.equal(res.getBody().data.reply.replyId);
  });
}

docs {
  `POST /api/create-reply/:postId` - same 1 to 500 character `content` rule as
  a post. The new `replyId` is written into the environment.
}
