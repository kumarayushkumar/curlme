meta {
  name: get top engaged
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/admin/top-engaged?limit=10
  body: none
  auth: inherit
}

params:query {
  limit: 10
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  `GET /api/admin/top-engaged` - accounts ranked by the engagement their posts attract.
}
