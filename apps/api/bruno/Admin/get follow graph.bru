meta {
  name: get follow graph
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/admin/follow-graph?limit=10
  body: none
  auth: inherit
}

params:query {
  limit: 10
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  `GET /api/admin/follow-graph` - the follow edges between the most connected accounts.
}
