meta {
  name: update profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/profile
  body: json
  auth: inherit
}

body:json {
  {
    "bio": "{{bio}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  `PATCH /api/profile` - edits your own bio. `bio` is required by the schema
  and is trimmed, up to 280 characters. Send `""` to clear it.
}
