meta {
  name: get my profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/profile
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("returns the signed in profile", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.profile.username).to.equal(bru.getEnvVar("username"));
  });
}

docs {
  `GET /api/profile` - the profile of whoever the token belongs to.
}
